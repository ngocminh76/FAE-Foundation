<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>WPF.UI</RootNamespace>
    <AssemblyName>WPF.UI</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Exclude old .NET Framework auto-generated files not needed in SDK-style projects -->
  <ItemGroup>
    <Compile Remove="Properties\Settings.Designer.cs" />
    <Compile Remove="Properties\Resources.Designer.cs" />
    <None Remove="Properties\Settings.settings" />
    <None Remove="App.config" />
  </ItemGroup>

  <!-- Resources: images included as WPF resources -->
  <ItemGroup>
    <Resource Include="Resources\caution.png" />
    <Resource Include="Resources\check.png" />
    <Resource Include="Resources\cross.png" />
    <Resource Include="Resources\information.png" />
    <Resource Include="Resources\think.png" />
    <Resource Include="Themes\Styles.xaml" />
  </ItemGroup>

</Project>
