<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WPF.UI;component/Themes/Color.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Base ListView style -->
    <Style x:Key="BaseListViewStyle"
           TargetType="ListView">
        <Setter Property="Background"
                Value="{StaticResource BrushMauNen}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource BrushBorderGrayColor}" />
        <Setter Property="Foreground"
                Value="{StaticResource BrushForegroundText}" />
    </Style>

    <!-- ListViewItem style -->
    <Style x:Key="BaseListViewItemStyle"
           TargetType="ListViewItem">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{StaticResource BrushForegroundText}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource BrushBorderGrayColor}" />
        <Setter Property="BorderThickness"
                Value="0,0,0,1" />
        <Setter Property="Padding"
                Value="8" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="4"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource BrushSubColor}" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource BrushMauHightlight2}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource BrushForegroundColor}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Opacity"
                                    Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GridView header style to match palette -->
    <Style x:Key="BaseGridViewColumnHeader"
           TargetType="GridViewColumnHeader">
        <Setter Property="Background"
                Value="{StaticResource BrushBackgroudPalette}" />
        <Setter Property="Foreground"
                Value="{StaticResource BrushForegroundColor}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource BrushBorderPalette}" />
        <Setter Property="BorderThickness"
                Value="0,0,0,1" />
        <Setter Property="Padding"
                Value="6,4" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
    </Style>
</ResourceDictionary>

