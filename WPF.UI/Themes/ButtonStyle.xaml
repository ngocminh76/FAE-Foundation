<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WPF.UI;component/Themes/Color.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="BtnStyleNormal"
           TargetType="{x:Type Button}">
        <Setter Property="Background"
                Value="{StaticResource BrushSubColor}" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Margin"
                Value="4" />
        <Setter Property="Width"
                Value="100" />
        <Setter Property="Height"
                Value="25" />
        <Setter Property="BorderBrush"
                Value="{StaticResource BrushBorderGrayColor}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                            CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Border.Effect>
                            <DropShadowEffect x:Name="ShadowEffect"
                                            Color="Black"
                                            Opacity="0.15"
                                            BlurRadius="3"
                                            ShadowDepth="1"
                                            Direction="270" />
                        </Border.Effect>
                        <Grid x:Name="ContentGrid"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ScaleTransform"
                                              ScaleX="1"
                                              ScaleY="1" />
                            </Grid.RenderTransform>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="0,0,0,0" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Resources>
                        <!-- Animation cho hover -->
                        <Storyboard x:Key="HoverEnterStoryboard">
                            <ColorAnimation Storyboard.TargetName="Border"
                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                          To="{StaticResource HoverColor}"
                                          Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="ShadowEffect"
                                           Storyboard.TargetProperty="Opacity"
                                           To="0.25"
                                           Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="ShadowEffect"
                                           Storyboard.TargetProperty="BlurRadius"
                                           To="5"
                                           Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                           Storyboard.TargetProperty="ScaleX"
                                           To="1.02"
                                           Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                           Storyboard.TargetProperty="ScaleY"
                                           To="1.02"
                                           Duration="0:0:0.15" />
                        </Storyboard>
                        <Storyboard x:Key="HoverLeaveStoryboard">
                            <ColorAnimation Storyboard.TargetName="Border"
                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                          To="{StaticResource SubColor}"
                                          Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="ShadowEffect"
                                           Storyboard.TargetProperty="Opacity"
                                           To="0.15"
                                           Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="ShadowEffect"
                                           Storyboard.TargetProperty="BlurRadius"
                                           To="3"
                                           Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                           Storyboard.TargetProperty="ScaleX"
                                           To="1"
                                           Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                           Storyboard.TargetProperty="ScaleY"
                                           To="1"
                                           Duration="0:0:0.15" />
                        </Storyboard>
                        <!-- Animation cho click/press -->
                        <Storyboard x:Key="PressedStoryboard">
                            <ColorAnimation Storyboard.TargetName="Border"
                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                          To="{StaticResource PressedColor}"
                                          Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                           Storyboard.TargetProperty="ScaleX"
                                           To="0.98"
                                           Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                           Storyboard.TargetProperty="ScaleY"
                                           To="0.98"
                                           Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetName="ShadowEffect"
                                           Storyboard.TargetProperty="ShadowDepth"
                                           To="0.5"
                                           Duration="0:0:0.1" />
                        </Storyboard>
                        <Storyboard x:Key="ReleasedStoryboard">
                            <ColorAnimation Storyboard.TargetName="Border"
                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                          To="{StaticResource HoverColor}"
                                          Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                           Storyboard.TargetProperty="ScaleX"
                                           To="1.02"
                                           Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                           Storyboard.TargetProperty="ScaleY"
                                           To="1.02"
                                           Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetName="ShadowEffect"
                                           Storyboard.TargetProperty="ShadowDepth"
                                           To="1"
                                           Duration="0:0:0.1" />
                        </Storyboard>
                    </ControlTemplate.Resources>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource HoverEnterStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource HoverLeaveStoryboard}" />
                            </Trigger.ExitActions>
                            <Setter Property="Foreground"
                                    Value="{StaticResource BrushMauHightlight}" />
                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource PressedStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource ReleasedStoryboard}" />
                            </Trigger.ExitActions>
                            <Setter Property="Foreground"
                                    Value="{StaticResource BrushMauHightlight}" />
                            <Setter Property="FontWeight"
                                    Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Background"
                                    Value="Gainsboro" />
                            <Setter Property="Opacity"
                                    Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <Style x:Key="BtnStyleIcon"
           TargetType="Button">
        <Setter Property="Width"
                Value="20" />
        <Setter Property="Height"
                Value="20" />
        <Setter Property="Padding"
                Value="4" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="ToolTipService.ShowDuration"
                Value="2000" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="IconBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0"
                            CornerRadius="4">
                        <Grid x:Name="IconContentGrid"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="IconScaleTransform"
                                              ScaleX="1"
                                              ScaleY="1" />
                            </Grid.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Resources>
                        <!-- Animation cho hover icon button -->
                        <Storyboard x:Key="IconHoverEnterStoryboard">
                            <ColorAnimation Storyboard.TargetName="IconBorder"
                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                          To="#E8E8E8"
                                          Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="IconScaleTransform"
                                           Storyboard.TargetProperty="ScaleX"
                                           To="1.1"
                                           Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="IconScaleTransform"
                                           Storyboard.TargetProperty="ScaleY"
                                           To="1.1"
                                           Duration="0:0:0.2" />
                        </Storyboard>
                        <Storyboard x:Key="IconHoverLeaveStoryboard">
                            <ColorAnimation Storyboard.TargetName="IconBorder"
                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                          To="Transparent"
                                          Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="IconScaleTransform"
                                           Storyboard.TargetProperty="ScaleX"
                                           To="1"
                                           Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="IconScaleTransform"
                                           Storyboard.TargetProperty="ScaleY"
                                           To="1"
                                           Duration="0:0:0.2" />
                        </Storyboard>
                        <!-- Animation cho click icon button -->
                        <Storyboard x:Key="IconPressedStoryboard">
                            <ColorAnimation Storyboard.TargetName="IconBorder"
                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                          To="#D0D0D0"
                                          Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetName="IconScaleTransform"
                                           Storyboard.TargetProperty="ScaleX"
                                           To="0.95"
                                           Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetName="IconScaleTransform"
                                           Storyboard.TargetProperty="ScaleY"
                                           To="0.95"
                                           Duration="0:0:0.1" />
                        </Storyboard>
                        <Storyboard x:Key="IconReleasedStoryboard">
                            <ColorAnimation Storyboard.TargetName="IconBorder"
                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                          To="#E8E8E8"
                                          Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetName="IconScaleTransform"
                                           Storyboard.TargetProperty="ScaleX"
                                           To="1.1"
                                           Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetName="IconScaleTransform"
                                           Storyboard.TargetProperty="ScaleY"
                                           To="1.1"
                                           Duration="0:0:0.1" />
                        </Storyboard>
                    </ControlTemplate.Resources>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource IconHoverEnterStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource IconHoverLeaveStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource IconPressedStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource IconReleasedStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Opacity"
                                    Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

