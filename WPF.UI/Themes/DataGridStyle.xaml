    <!-- Style Ä‘áº·c thÃ¹ cho báº£ng Ná»™i lá»±c (Táº£i trá»ng) káº¿ thá»«a tá»« DgStyle -->
    <Style x:Key="ForceColumnHeaderStyle"
           TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource ColumnHeaderStyle}">
        <Setter Property="Background"
                Value="{StaticResource BrushWarningColor}" />
        <Setter Property="Foreground"
                Value="Black" />
        <Setter Property="BorderBrush"
                Value="{StaticResource BrushBorderGrayColor}" />
        <Setter Property="BorderThickness"
                Value="1,1,1,0" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>

    <Style x:Key="ForceDataGridStyle"
           TargetType="{x:Type DataGrid}"
           BasedOn="{StaticResource DgStyle}">
        <Setter Property="ColumnHeaderStyle"
                Value="{StaticResource ForceColumnHeaderStyle}" />
        <Setter Property="AlternatingRowBackground"
                Value="White" />
        <Setter Property="RowBackground"
                Value="White" />
        <Setter Property="BorderBrush"
                Value="{StaticResource BrushBorderGrayColor}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="HorizontalGridLinesBrush"
                Value="{StaticResource BrushBorderGrayColor}" />
        <Setter Property="VerticalGridLinesBrush"
                Value="{StaticResource BrushBorderGrayColor}" />
        <Setter Property="GridLinesVisibility"
                Value="All" />
        <Setter Property="RowHeight"
                Value="32" />
    </Style>

    <!-- Style Bảng Nội Lực (ListBox Pseudo DataGrid) -->
    <Style x:Key="ForceListBoxStyle"
           TargetType="{x:Type ListBox}">
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding"
                            Value="0" />
                    <Setter Property="Margin"
                            Value="0" />
                    <Setter Property="BorderThickness"
                            Value="0" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Header -->
                        <Border Grid.Row="0"
                                Background="{StaticResource BrushPrimaryColor}"
                                BorderBrush="{StaticResource BrushBorderGrayColor}"
                                BorderThickness="1,1,1,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <!-- Dummy column for ScrollBar width -->
                                    <ColumnDefinition Width="12" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        BorderBrush="{StaticResource BrushBorderGrayColor}"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="TÊN CỘT (TRỤ)"
                                               FontWeight="Bold"
                                               Foreground="Black"
                                               TextAlignment="Center"
                                               Padding="8" />
                                </Border>
                                <Border Grid.Column="1"
                                        BorderBrush="{StaticResource BrushBorderGrayColor}"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="TỔ HỢP LỰC"
                                               FontWeight="Bold"
                                               Foreground="Black"
                                               TextAlignment="Center"
                                               Padding="8" />
                                </Border>
                                <Border Grid.Column="2"
                                        BorderBrush="{StaticResource BrushBorderGrayColor}"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="Qx"
                                               FontWeight="Bold"
                                               Foreground="Black"
                                               TextAlignment="Center"
                                               Padding="8" />
                                </Border>
                                <Border Grid.Column="3"
                                        BorderBrush="{StaticResource BrushBorderGrayColor}"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="Qy"
                                               FontWeight="Bold"
                                               Foreground="Black"
                                               TextAlignment="Center"
                                               Padding="8" />
                                </Border>
                                <Border Grid.Column="4"
                                        BorderBrush="{StaticResource BrushBorderGrayColor}"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="N"
                                               FontWeight="Bold"
                                               Foreground="Black"
                                               TextAlignment="Center"
                                               Padding="8" />
                                </Border>
                                <Border Grid.Column="5"
                                        BorderBrush="{StaticResource BrushBorderGrayColor}"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="Mx"
                                               FontWeight="Bold"
                                               Foreground="Black"
                                               TextAlignment="Center"
                                               Padding="8" />
                                </Border>
                                <Border Grid.Column="6"
                                        BorderBrush="{StaticResource BrushBorderGrayColor}"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="My"
                                               FontWeight="Bold"
                                               Foreground="Black"
                                               TextAlignment="Center"
                                               Padding="8" />
                                </Border>
                                <Border Grid.Column="7"
                                        BorderBrush="{StaticResource BrushBorderGrayColor}"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="Mz"
                                               FontWeight="Bold"
                                               Foreground="Black"
                                               TextAlignment="Center"
                                               Padding="8" />
                                </Border>
                                <Border Grid.Column="8"
                                        BorderThickness="0"
                                        Background="Transparent" />
                            </Grid>
                        </Border>
                        <!-- Content -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Visible"
                                      Style="{StaticResource SlimScrollViewerStyle}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BrushBorderGrayColor}"
                            BorderThickness="1,1,1,0"
                            Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35" />
                                <RowDefinition Height="35" />
                                <RowDefinition Height="35" />
                                <RowDefinition Height="35" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.RowSpan="4"
                                    Grid.Column="0"
                                    BorderBrush="{StaticResource BrushBorderGrayColor}"
                                    BorderThickness="0,0,1,1"
                                    Background="{StaticResource BrushMauNen}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TowerName}"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               TextAlignment="Center"
                                               Foreground="{StaticResource BrushPrimaryColor}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BaseDimension, StringFormat='Kích thước: {0:N0}'}"
                                               FontSize="13"
                                               TextAlignment="Center"
                                               Foreground="{StaticResource BrushTextMutedColor}"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    BorderBrush="{StaticResource BrushBorderGrayColor}"
                                    BorderThickness="0,0,1,1">
                                <TextBlock Text="LỰC NHỔ MAX"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </Border>
                            <Border Grid.Row="0"
                                    Grid.Column="2"
                                    BorderBrush="{StaticResource BrushBorderGrayColor}"
                                    BorderThickness="0,0,1,1">
                                <TextBox Text="{Binding MaxTensionLeg.Qx, StringFormat={}{0:N2}}"
                                         TextAlignment="Right"
                                         VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Margin="2" />
                            </Border>
                            <Border Grid.Row="0"
                                    Grid.Column="3"
                                    BorderBrush="{StaticResource BrushBorderGrayColor}"
                                    BorderThickness="0,0,1,1">
                                <TextBox Text="{Binding MaxTensionLeg.Qy, StringFormat={}{0:N2}}"
                                         TextAlignment="Right"
                                         VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Margin="2" />
                            </Border>
                            <Border Grid.Row="0"
                                    Grid.Column="4"
                                    BorderBrush="{StaticResource BrushBorderGrayColor}"
                                    BorderThickness="0,0,1,1">
                                <TextBox Text="{Binding MaxTensionLeg.N, StringFormat={}{0:N2}}"
                                         TextAlignment="Right"
                                         VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Margin="2"
                                         Foreground="{StaticResource BrushDangerColor}"
                                         FontWeight="Bold" />
                            </Border>
                            <Border Grid.Row="0"
                                    Grid.Column="5"
                                    BorderBrush="{StaticResource BrushBorderGrayColor}"
                                    BorderThickness="0,0,1,1">
                                <TextBox Text="{Binding MaxTensionLeg.Mx, StringFormat={}{0:N2}}"
                                         TextAlignment="Right"
                                         VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Margin="2" />
                            </Border>
                            <Border Grid.Row="0"
                                    Grid.Column="6"
                                    BorderBrush="{StaticResource BrushBorderGrayColor}"
                                    BorderThickness="0,0,1,1">
                                <TextBox Text="{Binding MaxTensionLeg.My, StringFormat={}{0:N2}}"
                                         TextAlignment="Right"
                                         VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Margin="2" />
                            </Border>
                            <Border Grid.Row="0"
                                    Grid.Column="7"
                                    BorderBrush="{StaticResource BrushBorderGrayColor}"
                                    BorderThickness="0,0,0,1">
                                <TextBox Text="{Binding MaxTensionLeg.Mz, StringFormat={}{0:N2}}"
                                         TextAlignment="Right"
                                         VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Margin="2" />
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    BorderBrush="{StaticResource BrushBorderGrayColor}"
                                    BorderThickness="0,0,1,1">
