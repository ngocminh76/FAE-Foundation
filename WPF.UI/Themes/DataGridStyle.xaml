    </Style>

    <!-- Styles cho DataGridTextColumn.EditingElementStyle (TextBox khi Ä‘ang edit) -->
    <!-- TextBox cÄƒn trÃ¡i -->
    <Style x:Key="DgTextBoxLeft"
           TargetType="{x:Type TextBox}">
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Padding"
                Value="4,0,4,0" />
    </Style>

    <!-- TextBox cÄƒn giá»¯a -->
    <Style x:Key="DgTextBoxCenter"
           TargetType="{x:Type TextBox}">
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
