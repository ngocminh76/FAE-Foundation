                        <Border Margin="1" x:Name="DisabledVisualElement" Background="#A5FFFFFF" BorderBrush="#59C0C0C0" BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False" Visibility="Collapsed" />
