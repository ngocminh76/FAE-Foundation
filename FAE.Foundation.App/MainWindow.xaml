<Window x:Class="FAE.Foundation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FAE.Foundation.App.Services.Localization"
        xmlns:features="clr-namespace:FAE.Foundation.App.Features.RibbedRaft"
        Title="FAE Foundation Design App" Height="800" Width="1400" WindowStartupLocation="CenterScreen">
    
    <Grid Background="#F5F6FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- SIDEBAR / MENU -->
        <Border Grid.Column="0" Background="#34495E">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="MÓNG BÈ SƯỜN" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,20" TextWrapping="Wrap" TextAlignment="Center"/>
                
                <StackPanel Grid.Row="1" Orientation="Vertical">
                    <Button Content="Thiết Kế Mới" Background="#2C3E50" Foreground="White" Height="40" Margin="0,0,0,10" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Mở File" Background="#2C3E50" Foreground="White" Height="40" Margin="0,0,0,10" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Lưu File" Background="#2C3E50" Foreground="White" Height="40" Margin="0,0,0,10" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Xuất Báo Cáo" Background="#2C3E50" Foreground="White" Height="40" Margin="0,0,0,10" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
                
                <Button Grid.Row="2" Content="{Binding Path=Strings[BtnDesign], Source={x:Static loc:LocalizationService.Instance}}" Background="#2980B9" Foreground="White" Height="40" FontSize="14" FontWeight="Bold" Margin="0,20,0,10"/>
                
                <Button Grid.Row="3" Content="Xem Lý Thuyết Tính Toán" Command="{Binding OpenTheoryCommand}" Background="#27AE60" Foreground="White" Height="30" FontSize="12" FontWeight="SemiBold"/>
            </Grid>
        </Border>
        
        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- HEADER (Language Toggle) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button Content="VI" Command="{Binding SetLanguageViCommand}" Width="40" Height="30" Margin="0,0,5,0" Background="#34495E" Foreground="White" FontWeight="Bold"/>
                <Button Content="EN" Command="{Binding SetLanguageEnCommand}" Width="40" Height="30" Background="#34495E" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
            
            <!-- TAB CONTROL FOR FOUNDATION TYPES -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabItem Header="Móng Bè Sườn" FontSize="16" FontWeight="SemiBold">
                    <features:RibbedRaftView DataContext="{Binding CurrentFoundationViewModel}" />
                </TabItem>
                <!-- Future Foundation Types -->
                <TabItem Header="Móng Đơn (Coming Soon)" FontSize="16" FontWeight="SemiBold" IsEnabled="False">
                    <TextBlock Text="Đang phát triển..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                </TabItem>
                <TabItem Header="Móng Cọc (Coming Soon)" FontSize="16" FontWeight="SemiBold" IsEnabled="False">
                    <TextBlock Text="Đang phát triển..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
