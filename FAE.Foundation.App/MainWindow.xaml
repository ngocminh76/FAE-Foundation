<Window x:Class="FAE.Foundation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FAE.Foundation.App"
        mc:Ignorable="d"
        Title="FAE-Foundation - Truyền Tải" Height="800" Width="1400"
        Background="#F0F2F5"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT PANEL: INPUTS -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="BẢNG NHẬP LIỆU" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                    
                    <!-- 1. TẢI TRỌNG -->
                    <Expander Header="1. NỘI LỰC (INTERNAL FORCES)" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="5,10,0,0">
                            <DataGrid ItemsSource="{Binding Loads}" AutoGenerateColumns="False" HeadersVisibility="Column" Background="White" CanUserAddRows="False" 
                                      RowHeight="25" AlternatingRowBackground="#F9F9F9" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0" BorderBrush="#CCCCCC">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#34495E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Chân" Binding="{Binding Name}" Width="60"/>
                                    <DataGridTextColumn Header="N (kN)" Binding="{Binding N}" Width="*"/>
                                    <DataGridTextColumn Header="Mx (kNm)" Binding="{Binding Mx}" Width="*"/>
                                    <DataGridTextColumn Header="My (kNm)" Binding="{Binding My}" Width="*"/>
                                    <DataGridTextColumn Header="Qx (kN)" Binding="{Binding Qx}" Width="*"/>
                                    <DataGridTextColumn Header="Qy (kN)" Binding="{Binding Qy}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                    
                    <!-- 2. SỐ LIỆU ĐỊA CHẤT -->
                    <Expander Header="2. SỐ LIỆU ĐỊA CHẤT" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="5,10,0,0">
                            <DataGrid ItemsSource="{Binding Soils}" AutoGenerateColumns="False" HeadersVisibility="Column" Background="White" CanUserAddRows="True"
                                      RowHeight="25" AlternatingRowBackground="#F9F9F9" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0" BorderBrush="#CCCCCC">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#34495E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Lớp" Binding="{Binding Name}" Width="80"/>
                                    <DataGridTextColumn Header="Dày(m)" Binding="{Binding Thickness}" Width="50"/>
                                    <DataGridTextColumn Header="γ" Binding="{Binding Gamma}" Width="40"/>
                                    <DataGridTextColumn Header="c" Binding="{Binding C}" Width="40"/>
                                    <DataGridTextColumn Header="φ" Binding="{Binding Phi}" Width="40"/>
                                    <DataGridTextColumn Header="E0" Binding="{Binding E0}" Width="50"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                    
                    <!-- 3. KÍCH THƯỚC BÊ TÔNG -->
                    <Expander Header="3. THÔNG SỐ HÌNH HỌC" IsExpanded="True" Margin="0,0,0,10">
                        <Grid Margin="5,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nhịp cột phương X (L_span_X):" VerticalAlignment="Center" Margin="0,0,0,8" FontWeight="Bold"/>
                            <TextBox x:Name="txt_khoang_cach_cot" Grid.Row="0" Grid.Column="1" Text="5.0" VerticalAlignment="Center" Margin="0,0,0,8" TextChanged="Input_Changed"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Độ vươn Console Trái (L_cons_L):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="txt_L_cons_L" Grid.Row="1" Grid.Column="1" Text="1.5" VerticalAlignment="Center" Margin="0,0,0,8" TextChanged="Input_Changed"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Độ vươn Console Phải (L_cons_R):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="txt_L_cons_R" Grid.Row="2" Grid.Column="1" Text="1.5" VerticalAlignment="Center" Margin="0,0,0,8" TextChanged="Input_Changed"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="=> Chiều dài móng (L_móng):" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="DarkRed"/>
                            <TextBlock x:Name="lbl_L_mong" Grid.Row="3" Grid.Column="1" Text="8.0" VerticalAlignment="Center" Margin="0,0,0,8" FontWeight="Bold" Foreground="DarkRed"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="5,0,0,8" Foreground="DarkRed"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Nhịp cột phương Y (L_span_Y):" VerticalAlignment="Center" Margin="0,0,0,8" FontWeight="Bold"/>
                            <TextBox x:Name="txt_L_span_Y" Grid.Row="4" Grid.Column="1" Text="5.0" VerticalAlignment="Center" Margin="0,0,0,8" TextChanged="Input_Changed"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Console Trên (L_cons_Top):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="txt_L_cons_T" Grid.Row="5" Grid.Column="1" Text="1.5" VerticalAlignment="Center" Margin="0,0,0,8" TextChanged="Input_Changed"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Console Dưới (L_cons_Bot):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="txt_L_cons_B" Grid.Row="6" Grid.Column="1" Text="1.5" VerticalAlignment="Center" Margin="0,0,0,8" TextChanged="Input_Changed"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="=> Chiều rộng móng (B_móng):" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="DarkRed"/>
                            <TextBlock x:Name="lbl_B_mong" Grid.Row="7" Grid.Column="1" Text="8.0" VerticalAlignment="Center" Margin="0,0,0,8" FontWeight="Bold" Foreground="DarkRed"/>
                            <TextBlock Grid.Row="7" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="5,0,0,8" Foreground="DarkRed"/>
                            
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Chiều dày bản móng (h_bản):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="txt_h_ban" Grid.Row="8" Grid.Column="1" Text="0.4" VerticalAlignment="Center" Margin="0,0,0,8" TextChanged="Input_Changed"/>
                            <TextBlock Grid.Row="8" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Bề rộng dầm sườn (b_dầm):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="txt_b_dam" Grid.Row="9" Grid.Column="1" Text="0.4" VerticalAlignment="Center" Margin="0,0,0,8" TextChanged="Input_Changed"/>
                            <TextBlock Grid.Row="9" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>
                            
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Chiều cao dầm sườn (h_dầm):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="txt_h_dam" Grid.Row="10" Grid.Column="1" Text="0.4" VerticalAlignment="Center" Margin="0,0,0,8" TextChanged="Input_Changed"/>
                            <TextBlock Grid.Row="10" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>
                            
                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Kích thước cạnh cổ cột (b_cột):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="txt_b_cot" Grid.Row="11" Grid.Column="1" Text="0.6" VerticalAlignment="Center" Margin="0,0,0,8" TextChanged="Input_Changed"/>
                            <TextBlock Grid.Row="11" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>
                            
                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Chiều sâu chôn móng (D_f):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="txt_D_f" Grid.Row="12" Grid.Column="1" Text="3.5" VerticalAlignment="Center" Margin="0,0,0,8" TextChanged="Input_Changed"/>
                            <TextBlock Grid.Row="12" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>
                        </Grid>
                    </Expander>
                    
                    <!-- 4. MÔI TRƯỜNG -->
                    <Expander Header="4. MÔI TRƯỜNG &amp; LỚP ĐỆM" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="5,10,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="chk_cushion" Content="Có đệm cát thay đất" IsChecked="True" VerticalAlignment="Center" Width="180" Click="Input_Changed"/>
                                <TextBlock Text="Dày:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txt_h_cat" Text="0.5" Width="50" VerticalAlignment="Center" TextChanged="Input_Changed"/>
                                <TextBlock Text="m" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="chk_mound" Content="Có ụ đất đối trọng" IsChecked="True" VerticalAlignment="Center" Width="180" Click="Input_Changed"/>
                                <TextBlock Text="Cao:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txt_h_doi_trong" Text="1.5" Width="50" VerticalAlignment="Center" TextChanged="Input_Changed"/>
                                <TextBlock Text="m" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="chk_gwt" Content="Có mực nước ngầm" IsChecked="True" VerticalAlignment="Center" Width="180" Click="Input_Changed"/>
                                <TextBlock Text="Cao độ:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txt_y_gwt" Text="-1.2" Width="50" VerticalAlignment="Center" TextChanged="Input_Changed"/>
                                <TextBlock Text="m" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    
                    <!-- BUTTONS -->
                    <Button x:Name="btnDesign" Content="THIẾT KẾ VÀ KIỂM TOÁN" Background="#2980B9" Foreground="White" Height="40" FontSize="14" FontWeight="Bold" Margin="0,20,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#BDC3C7"/>
        
        <!-- RIGHT PANEL: VIEWPORTS (2x2 GRID) -->
        <Grid Grid.Column="2" Margin="10" Background="#DFE6E9">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- TOP-LEFT: PLAN VIEW -->
            <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="5" Padding="5" Margin="2">
                <Grid>
                    <TextBlock Text="MẶT BẰNG MÓNG (PLAN VIEW)" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" Panel.ZIndex="1"/>
                    <Canvas x:Name="PlanCanvas" ClipToBounds="True" Background="#F8FAFC" SizeChanged="DrawingCanvas_SizeChanged"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- TOP-RIGHT: 3D VIEWPORT -->
            <Border Grid.Row="0" Grid.Column="2" Background="White" CornerRadius="5" Padding="5" Margin="2" MouseLeftButtonDown="Viewport3D_MouseLeftButtonDown" MouseLeftButtonUp="Viewport3D_MouseLeftButtonUp" MouseMove="Viewport3D_MouseMove" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="MÔ HÌNH 3D (Kéo chuột để xoay)" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" Panel.ZIndex="1"/>
                    <Viewport3D x:Name="MainViewport3D">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="Camera3D" Position="15,18,22" LookDirection="-15,-18,-22" UpDirection="0,1,0" FieldOfView="45"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup x:Name="Model3DGroup">
                                    <Model3DGroup.Transform>
                                        <Transform3DGroup>
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="RotX" Axis="1,0,0" Angle="0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="RotY" Axis="0,1,0" Angle="0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                        </Transform3DGroup>
                                    </Model3DGroup.Transform>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="4" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- BOTTOM-LEFT: SECTION X -->
            <Border Grid.Row="2" Grid.Column="0" Background="White" CornerRadius="5" Padding="5" Margin="2">
                <Grid>
                    <TextBlock Text="MẶT CẮT PHƯƠNG X (SECTION X)" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" Panel.ZIndex="1"/>
                    <Canvas x:Name="DrawingCanvas" ClipToBounds="True" Background="#F8FAFC" SizeChanged="DrawingCanvas_SizeChanged"/>
                </Grid>
            </Border>

            <!-- BOTTOM-RIGHT: SECTION Y -->
            <Border Grid.Row="2" Grid.Column="2" Background="White" CornerRadius="5" Padding="5" Margin="2">
                <Grid>
                    <TextBlock Text="MẶT CẮT PHƯƠNG Y (SECTION Y)" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" Panel.ZIndex="1"/>
                    <Canvas x:Name="SectionYCanvas" ClipToBounds="True" Background="#F8FAFC" SizeChanged="DrawingCanvas_SizeChanged"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
