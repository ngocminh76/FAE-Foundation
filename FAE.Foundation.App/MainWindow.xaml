<Window x:Class="FAE.Foundation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FAE Foundation Design"
        Height="460"
        Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPF.UI;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Card style dùng inline, không dùng key từ thư viện -->
            <Style x:Key="CardBorder"
                   TargetType="Border">
                <Setter Property="Background"
                        Value="White" />
                <Setter Property="BorderBrush"
                        Value="{StaticResource BrushBorderGrayColor}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="6" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver"
                             Value="True">
                        <Setter Property="Background"
                                Value="{StaticResource BrushHoverColor}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushMauNen}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBackgroudPalette}"
                Padding="24,16">
            <TextBlock Text="FAE Foundation Design"
                       Foreground="{StaticResource BrushForegroundColor}"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- 3 Cards -->
        <UniformGrid Grid.Row="1"
                     Columns="3"
                     Margin="36,32,36,32">

            <!-- Móng Trụ -->
            <Border Margin="10"
                    Style="{StaticResource CardBorder}"
                    Cursor="Hand">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="16">
                    <TextBlock Text="🏛"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Móng Trụ"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushForegroundText}" />
                    <TextBlock Text="Móng đơn dưới cột"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushTextMutedColor}"
                               Margin="0,4,0,14" />
                    <Button Content="Mở"
                            Style="{StaticResource BtnStyleNormal}"
                            HorizontalAlignment="Center"
                            x:Name="BtnMongTru"
                            Click="BtnMongTru_Click" />
                </StackPanel>
            </Border>

            <!-- Móng Bản -->
            <Border Margin="10"
                    Style="{StaticResource CardBorder}"
                    Cursor="Hand">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="16">
                    <TextBlock Text="⬛"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Móng Bản"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushForegroundText}" />
                    <TextBlock Text="Móng bè toàn diện tích"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushTextMutedColor}"
                               Margin="0,4,0,14" />
                    <Button Content="Mở"
                            Style="{StaticResource BtnStyleNormal}"
                            HorizontalAlignment="Center"
                            x:Name="BtnMongBan"
                            Click="BtnMongBan_Click" />
                </StackPanel>
            </Border>

            <!-- Móng Cọc -->
            <Border Margin="10"
                    Style="{StaticResource CardBorder}"
                    Cursor="Hand">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="16">
                    <TextBlock Text="🔩"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Móng Cọc"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushForegroundText}" />
                    <TextBlock Text="Móng cọc nhồi / cọc ép"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushTextMutedColor}"
                               Margin="0,4,0,14" />
                    <Button Content="Mở"
                            Style="{StaticResource BtnStyleNormal}"
                            HorizontalAlignment="Center"
                            x:Name="BtnMongCoc"
                            Click="BtnMongCoc_Click" />
                </StackPanel>
            </Border>

        </UniformGrid>
    </Grid>
</Window>
