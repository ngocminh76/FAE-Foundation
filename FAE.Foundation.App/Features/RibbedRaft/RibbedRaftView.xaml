<UserControl x:Class="FAE.Foundation.App.Features.RibbedRaft.RibbedRaftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:FAE.Foundation.App.Services.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid Background="#F5F6FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT PANEL: INPUTS -->
        <Border Grid.Column="0" Background="White" Margin="10" Padding="15" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0">
                    <!-- 0. TEN MONG -->
                    <Border Background="#E8F8F5" BorderBrush="#1ABC9C" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tên Móng:" FontWeight="Bold" Foreground="#16A085" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Model.FoundationName}" FontWeight="Bold" Foreground="#2C3E50" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 1. THONG SO KICH THUOC -->
                    <Expander Header="Thông số kích thước móng" IsExpanded="True" Margin="0,0,0,10">
                        <Grid Margin="5,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Kich thuoc chan tru -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Kích thước chân trụ (Lx, Ly):" VerticalAlignment="Center" Margin="0,0,0,8" FontWeight="Bold" Foreground="#8E44AD"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Model.Lx, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="x" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Model.Ly, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>
                            
                            <!-- Kich thuoc mong -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Kích thước móng (B, L):" VerticalAlignment="Center" Margin="0,0,0,8" FontWeight="Bold" Foreground="#2980B9"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Model.TotalWidth, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="x" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Model.TotalLength, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>

                            <!-- Chieu cao mong H -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Chiều cao móng (H):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Model.Depth, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,8" Grid.ColumnSpan="3"/>
                            <TextBlock Grid.Row="2" Grid.Column="4" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>

                            <!-- Dam mong a x h -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Dầm móng (a, h):" VerticalAlignment="Center" Margin="0,0,0,8" FontWeight="Bold"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Model.RibWidth, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="x" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Model.RibHeight, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="4" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>

                            <!-- Ban mong h1, c -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Bản móng (h1, lỗ c):" VerticalAlignment="Center" Margin="0,0,0,8" FontWeight="Bold"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Model.SlabThickness, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="-" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Model.HoleSize, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="4" Grid.Column="4" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>

                            <!-- Co mong b1, b2 -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Cổ móng (b1, b2):" VerticalAlignment="Center" Margin="0,0,0,8" FontWeight="Bold"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Model.B1, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="x" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding Model.B2, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="5" Grid.Column="4" Text="m" VerticalAlignment="Center" Margin="5,0,0,8"/>
                        </Grid>
                    </Expander>
                    
                    <!-- KET QUA TINH TOAN -->
                    <Expander Header="Kết quả tính toán" IsExpanded="True" Margin="0,0,0,10">
                        <Grid Margin="5,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Diện tích đáy móng (F):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Model.FoundationArea, StringFormat=F2}" FontWeight="Bold" Foreground="#16A085" VerticalAlignment="Center" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="m²" VerticalAlignment="Center" Margin="5,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Mômen kháng đáy móng Wx:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Model.Wx, StringFormat=F2}" FontWeight="Bold" Foreground="#E67E22" VerticalAlignment="Center" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="m³" VerticalAlignment="Center" Margin="5,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Mômen kháng đáy móng Wy:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Model.Wy, StringFormat=F2}" FontWeight="Bold" Foreground="#E67E22" VerticalAlignment="Center" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="m³" VerticalAlignment="Center" Margin="5,0,0,8"/>
                        </Grid>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#BDC3C7"/>

        <!-- RIGHT PANEL: VIEWPORTS -->
        <Grid Grid.Column="2" Background="#E5E8E8" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TOP-LEFT: PLAN VIEW -->
            <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="5" Padding="5" Margin="2">
                <Grid>
                    <TextBlock Text="{Binding Path=Strings[PlanView], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" Panel.ZIndex="1"/>
                    <Canvas x:Name="PlanCanvas" ClipToBounds="True" Background="#F8FAFC" SizeChanged="DrawingCanvas_SizeChanged"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- TOP-RIGHT: 3D VIEWPORT -->
            <Border Grid.Row="0" Grid.Column="2" Background="White" CornerRadius="5" Padding="5" Margin="2" MouseLeftButtonDown="Viewport3D_MouseLeftButtonDown" MouseLeftButtonUp="Viewport3D_MouseLeftButtonUp" MouseMove="Viewport3D_MouseMove" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="{Binding Path=Strings[View3D], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" Panel.ZIndex="1"/>
                    <Viewport3D x:Name="MainViewport3D">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="Camera3D" Position="15,18,22" LookDirection="-15,-18,-22" UpDirection="0,1,0" FieldOfView="45"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup x:Name="Model3DGroup">
                                    <Model3DGroup.Transform>
                                        <Transform3DGroup>
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="RotX" Axis="1,0,0" Angle="0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="RotY" Axis="0,1,0" Angle="0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                        </Transform3DGroup>
                                    </Model3DGroup.Transform>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="4" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- BOTTOM-LEFT: SECTION X -->
            <Border Grid.Row="2" Grid.Column="0" Background="White" CornerRadius="5" Padding="5" Margin="2">
                <Grid>
                    <TextBlock Text="{Binding Path=Strings[SectionX], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" Panel.ZIndex="1"/>
                    <Canvas x:Name="SectionXCanvas" ClipToBounds="True" Background="#F8FAFC" SizeChanged="DrawingCanvas_SizeChanged"/>
                </Grid>
            </Border>

            <!-- BOTTOM-RIGHT: SECTION Y -->
            <Border Grid.Row="2" Grid.Column="2" Background="White" CornerRadius="5" Padding="5" Margin="2">
                <Grid>
                    <TextBlock Text="{Binding Path=Strings[SectionY], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" Panel.ZIndex="1"/>
                    <Canvas x:Name="SectionYCanvas" ClipToBounds="True" Background="#F8FAFC" SizeChanged="DrawingCanvas_SizeChanged"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
