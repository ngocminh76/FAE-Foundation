<UserControl x:Class="FAE.Foundation.App.Features.RibbedRaft.GeotechCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FAE.Foundation.App.Services.Localization"
             Language="en-US">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="#F5F6FA" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- COLUMN 1: Settings & Sections -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="5">
                <Border Background="White"
                        Padding="15"
                        CornerRadius="8"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Thông số nền đất"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Chọn hố khoan:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableBoreholes}"
                                      SelectedItem="{Binding CurrentBorehole}"
                                      DisplayMemberPath="BoreholeName"
                                      Padding="5" />
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Chiều sâu chôn móng (H1):"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#D35400" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Model.EmbedmentDepth, UpdateSourceTrigger=PropertyChanged, Delay=800}"
                                     VerticalAlignment="Center"
                                     Padding="4" />
                            <TextBlock Grid.Column="2"
                                       Text="m"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Chiều cao móng (H):"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Model.Depth, UpdateSourceTrigger=PropertyChanged, Delay=800}"
                                     VerticalAlignment="Center"
                                     Padding="4" />
                            <TextBlock Grid.Column="2"
                                       Text="m"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0" />
                        </Grid>

                        <!-- Tùy chọn đệm cát -->
                        <CheckBox Content="Sử dụng đệm cát"
                                  IsChecked="{Binding Model.HasSandCushion, UpdateSourceTrigger=PropertyChanged}"
                                  FontWeight="SemiBold"
                                  Margin="0,10,0,5" />
                        <Grid IsEnabled="{Binding Model.HasSandCushion}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Bề dày đệm cát:"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Model.SandThickness, UpdateSourceTrigger=PropertyChanged, Delay=800}"
                                     VerticalAlignment="Center"
                                     Padding="4" />
                            <TextBlock Grid.Column="2"
                                       Text="m"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0" />
                        </Grid>

                        <!-- Tùy chọn đất đắp -->
                        <CheckBox Content="Đắp đất chống nhổ"
                                  IsChecked="{Binding Model.HasMound, UpdateSourceTrigger=PropertyChanged}"
                                  FontWeight="SemiBold"
                                  Margin="0,10,0,5" />
                        <Grid IsEnabled="{Binding Model.HasMound}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Chiều cao đất đắp:"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Model.MoundHeight, UpdateSourceTrigger=PropertyChanged, Delay=800}"
                                     VerticalAlignment="Center"
                                     Padding="4" />
                            <TextBlock Grid.Column="2"
                                       Text="m"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="8"
                        Padding="5"
                        MinHeight="300"
                        Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="{Binding Path=Strings[SectionX], Source={x:Static loc:LocalizationService.Instance}}"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Margin="5"
                                   Panel.ZIndex="1" />
                        <Canvas x:Name="SectionXCanvas"
                                ClipToBounds="True"
                                Background="#F8FAFC"
                                SizeChanged="DrawingCanvas_SizeChanged" />
                    </Grid>
                </Border>

                <Border Background="White"
                        CornerRadius="8"
                        Padding="5"
                        MinHeight="300">
                    <Grid>
                        <TextBlock Text="{Binding Path=Strings[SectionY], Source={x:Static loc:LocalizationService.Instance}}"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Margin="5"
                                   Panel.ZIndex="1" />
                        <Canvas x:Name="SectionYCanvas"
                                ClipToBounds="True"
                                Background="#F8FAFC"
                                SizeChanged="DrawingCanvas_SizeChanged" />
                    </Grid>
                </Border>

                <!-- Chú thích chung các lớp địa chất -->
                <Border Background="White"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Chú thích các lớp địa chất:"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding CurrentBorehole.Layers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,5,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LayerId}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LayerId}"
                                                                 Value="">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Grid Width="20"
                                              Height="20"
                                              Margin="0,0,10,0">
                                            <Ellipse Stroke="SaddleBrown"
                                                     StrokeThickness="1"
                                                     Fill="White" />
                                            <TextBlock Text="{Binding LayerId}"
                                                       Foreground="SaddleBrown"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10" />
                                        </Grid>
                                        <TextBlock Text="{Binding LayerName}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#34495E" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

                <!-- COLUMN 2: Kết quả tính ứng suất -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="White" Margin="5" Padding="15" CornerRadius="8">
                <StackPanel>
                    <!-- BẢNG TẢI TRỌNG TIÊU CHUẨN + BIỆN LUẬN CHI PHỐI -->
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="BẢNG TẢI TRỌNG TIÊU CHUẨN ĐẦU VÀO" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8" FontSize="13"/>

                            <!-- TH1 row -->
                            <Border Background="White" CornerRadius="4" Padding="8,5" Margin="0,0,0,4" BorderBrush="#E2E8F0" BorderThickness="1">
                                <TextBlock FontSize="12">
                                    <Run Text="{Binding CalculationResult.TH1_Name}" FontWeight="Bold" Foreground="#334155"/>
                                    <Run Text="  |  N = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH1_N, StringFormat={}{0:F2}}" Foreground="#334155"/>
                                    <Run Text=" T  |  Qx = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH1_Qx, StringFormat={}{0:F2}}" Foreground="#334155"/>
                                    <Run Text=" T, Qy = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH1_Qy, StringFormat={}{0:F2}}" Foreground="#334155"/>
                                    <Run Text=" T  |  Mx = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH1_Mx, StringFormat={}{0:F2}}" Foreground="#334155"/>
                                    <Run Text=" T.m, My = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH1_My, StringFormat={}{0:F2}}" Foreground="#334155"/>
                                    <Run Text=" T.m" Foreground="#64748B"/>
                                    <LineBreak/>
                                    <Run Text="    Mxđáy = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH1_Mx_Base, StringFormat={}{0:F2}}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                    <Run Text=" T.m,  Myđáy = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH1_My_Base, StringFormat={}{0:F2}}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                    <Run Text=" T.m,  Qtruốt = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH1_Qtruot, StringFormat={}{0:F2}}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                    <Run Text=" T" Foreground="#64748B"/>
                                </TextBlock>
                            </Border>

                            <!-- TH2 row -->
                            <Border Background="White" CornerRadius="4" Padding="8,5" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                <TextBlock FontSize="12">
                                    <Run Text="{Binding CalculationResult.TH2_Name}" FontWeight="Bold" Foreground="#334155"/>
                                    <Run Text="  |  N = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH2_N, StringFormat={}{0:F2}}" Foreground="#334155"/>
                                    <Run Text=" T  |  Qx = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH2_Qx, StringFormat={}{0:F2}}" Foreground="#334155"/>
                                    <Run Text=" T, Qy = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH2_Qy, StringFormat={}{0:F2}}" Foreground="#334155"/>
                                    <Run Text=" T  |  Mx = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH2_Mx, StringFormat={}{0:F2}}" Foreground="#334155"/>
                                    <Run Text=" T.m, My = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH2_My, StringFormat={}{0:F2}}" Foreground="#334155"/>
                                    <Run Text=" T.m" Foreground="#64748B"/>
                                    <LineBreak/>
                                    <Run Text="    Mxđáy = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH2_Mx_Base, StringFormat={}{0:F2}}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                    <Run Text=" T.m,  Myđáy = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH2_My_Base, StringFormat={}{0:F2}}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                    <Run Text=" T.m,  Qtruốt = " Foreground="#64748B"/>
                                    <Run Text="{Binding CalculationResult.TH2_Qtruot, StringFormat={}{0:F2}}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                    <Run Text=" T" Foreground="#64748B"/>
                                </TextBlock>
                            </Border>

                            <!-- BIỆN LUẬN ĐỘNG -->
                            <TextBlock Text="→ BIỆN LUẬN CHỌN TỔ HỢP CHI PHỐI:" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,5" FontSize="12"/>
                            <Border Background="#FFFBEB" CornerRadius="4" Padding="8,6" Margin="0,0,0,3" BorderBrush="#FCD34D" BorderThickness="1">
                                <TextBlock Text="{Binding CalculationResult.StressGoverns_Text, Mode=OneWay}" FontStyle="Italic" Foreground="#92400E" FontSize="12"/>
                            </Border>
                            <Border Background="#EFF6FF" CornerRadius="4" Padding="8,6" Margin="0,0,0,3" BorderBrush="#93C5FD" BorderThickness="1">
                                <TextBlock Text="{Binding CalculationResult.OvtGoverns_Text, Mode=OneWay}" FontStyle="Italic" Foreground="#1E40AF" FontSize="12"/>
                            </Border>
                            <Border Background="#EFF6FF" CornerRadius="4" Padding="8,6" Margin="0,0,0,0" BorderBrush="#93C5FD" BorderThickness="1">
                                <TextBlock Text="{Binding CalculationResult.SlideGoverns_Text, Mode=OneWay}" FontStyle="Italic" Foreground="#1E40AF" FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="1. Kiểm tra khả năng chịu tải của nền" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10" />

                    <!-- 1.1 Dưới đáy móng -->
                    <StackPanel Margin="10,0,0,15">
                        <TextBlock FontWeight="SemiBold" FontStyle="Italic" Margin="0,5,0,5">
                            <Run Text="1.1 Kiểm tra khả năng chịu tải của đất nền dưới đáy móng  (Tổ hợp chi phối: "/>
                            <Run Text="{Binding CalculationResult.StressGoverns_Name, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text=")"/>
                        </TextBlock>

                        <!-- Row Phi, A, B, D -->
                        <WrapPanel Margin="10,2,0,5">
                            <TextBlock Text="φ = " /><TextBlock Text="{Binding CalculationResult.Phi1, StringFormat={}{0:F2}}" FontWeight="Bold" Margin="0,0,25,0"/>
                            <TextBlock Text="A = " /><TextBlock Text="{Binding CalculationResult.A1, StringFormat={}{0:F2}}" FontWeight="Bold" Margin="0,0,25,0"/>
                            <TextBlock Text="B = " /><TextBlock Text="{Binding CalculationResult.B1, StringFormat={}{0:F2}}" FontWeight="Bold" Margin="0,0,25,0"/>
                            <TextBlock Text="D = " /><TextBlock Text="{Binding CalculationResult.D1, StringFormat={}{0:F2}}" FontWeight="Bold"/>
                        </WrapPanel>

                        <TextBlock Text="Áp lực tiêu chuẩn của nền đất Rtc = m(A.b.γdn + B.h1.γ1 + D.c)" Margin="10,2,0,5" Foreground="#7F8C8D"/>

                        <StackPanel Orientation="Horizontal" Margin="10,2,0,10">
                            <TextBlock Text="Mxđáy = " /><TextBlock Text="{Binding CalculationResult.Mx_Base, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#2980B9"/>
                            <TextBlock Text=" (T.m)    Myđáy = " /><TextBlock Text="{Binding CalculationResult.My_Base, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#2980B9"/>
                            <TextBlock Text=" (T.m)"/>
                        </StackPanel>

                        <!-- Case 1: MNN Sát mặt đất -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="10,5,0,8">
                            <StackPanel>
                                <TextBlock Text="a. Trường hợp mực nước ngầm sát mặt đất:" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="Rtc = " /><TextBlock Text="{Binding CalculationResult.Rtc1_GW_Surface, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="σmax = " /><TextBlock Text="{Binding CalculationResult.SigmaMax1_GW_Surface, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²)  &lt;  1.2 Rtc = " /><TextBlock Text="{Binding CalculationResult.Rtc1_GW_Surface_12, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#27AE60"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="N0 = " /><TextBlock Text="{Binding CalculationResult.N01_GW_Surface, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="σtb = " /><TextBlock Text="{Binding CalculationResult.SigmaTb1_GW_Surface, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²)  &lt;  Rtc = " /><TextBlock Text="{Binding CalculationResult.Rtc1_GW_Surface, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#27AE60"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="σmin = " /><TextBlock Text="{Binding CalculationResult.SigmaMin1_GW_Surface, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²) "/><TextBlock Text="{Binding CalculationResult.SigmaMin1_GW_Surface_Text}" FontWeight="Bold" Foreground="{Binding CalculationResult.SigmaMin1_GW_Surface_Color}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Case 2: MNN Sát đáy móng -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="10,0,0,8">
                            <StackPanel>
                                <TextBlock Text="b. Trường hợp mực nước ngầm sát mặt đáy móng:" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="Rtc = " /><TextBlock Text="{Binding CalculationResult.Rtc1_GW_Base, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="σmax = " /><TextBlock Text="{Binding CalculationResult.SigmaMax1_GW_Base, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²)  &lt;  1.2 Rtc = " /><TextBlock Text="{Binding CalculationResult.Rtc1_GW_Base_12, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#27AE60"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="N0 = " /><TextBlock Text="{Binding CalculationResult.N01_GW_Base, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="σtb = " /><TextBlock Text="{Binding CalculationResult.SigmaTb1_GW_Base, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²)  &lt;  Rtc = " /><TextBlock Text="{Binding CalculationResult.Rtc1_GW_Base, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#27AE60"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="σmin = " /><TextBlock Text="{Binding CalculationResult.SigmaMin1_GW_Base, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²) "/><TextBlock Text="{Binding CalculationResult.SigmaMin1_GW_Base_Text}" FontWeight="Bold" Foreground="{Binding CalculationResult.SigmaMin1_GW_Base_Color}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 1.2 Dưới đáy đệm cát -->
                    <StackPanel Visibility="{Binding CalculationResult.HasSandCushion, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="10,0,0,15">
                        <TextBlock Text="1.2 Kiểm tra khả năng chịu tải của đất nền dưới đáy đệm cát" FontWeight="SemiBold" FontStyle="Italic" Margin="0,5,0,5" />
                        
                        <WrapPanel Margin="10,2,0,5">
                            <TextBlock Text="φ = " /><TextBlock Text="{Binding CalculationResult.Phi2, StringFormat={}{0:F2}}" FontWeight="Bold" Margin="0,0,25,0"/>
                            <TextBlock Text="A = " /><TextBlock Text="{Binding CalculationResult.A2, StringFormat={}{0:F2}}" FontWeight="Bold" Margin="0,0,25,0"/>
                            <TextBlock Text="B = " /><TextBlock Text="{Binding CalculationResult.B2, StringFormat={}{0:F2}}" FontWeight="Bold" Margin="0,0,25,0"/>
                            <TextBlock Text="D = " /><TextBlock Text="{Binding CalculationResult.D2, StringFormat={}{0:F2}}" FontWeight="Bold"/>
                        </WrapPanel>

                        <TextBlock Text="Áp lực tiêu chuẩn của nền đất Rtc = m(A.bqu.γdn + B.hqu.γ1 + D.c)" Margin="10,2,0,5" Foreground="#7F8C8D"/>

                        <!-- Case 1: MNN Sát mặt đất -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="10,5,0,8">
                            <StackPanel>
                                <TextBlock Text="a. Trường hợp mực nước ngầm sát mặt đất:" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="Rtc = " /><TextBlock Text="{Binding CalculationResult.Rtc2_GW_Surface, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="σmax = " /><TextBlock Text="{Binding CalculationResult.SigmaMax2_GW_Surface, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²)  &lt;  1.2 Rtc = " /><TextBlock Text="{Binding CalculationResult.Rtc2_GW_Surface_12, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#27AE60"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="N0 = " /><TextBlock Text="{Binding CalculationResult.N02_GW_Surface, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="σtb = " /><TextBlock Text="{Binding CalculationResult.SigmaTb2_GW_Surface, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²)  &lt;  Rtc = " /><TextBlock Text="{Binding CalculationResult.Rtc2_GW_Surface, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#27AE60"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="σmin = " /><TextBlock Text="{Binding CalculationResult.SigmaMin2_GW_Surface, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²) "/><TextBlock Text="{Binding CalculationResult.SigmaMin2_GW_Surface_Text}" FontWeight="Bold" Foreground="{Binding CalculationResult.SigmaMin2_GW_Surface_Color}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Case 2: MNN Sát đáy móng -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="10,0,0,8">
                            <StackPanel>
                                <TextBlock Text="b. Trường hợp mực nước ngầm sát mặt đáy móng:" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="Rtc = " /><TextBlock Text="{Binding CalculationResult.Rtc2_GW_Base, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="σmax = " /><TextBlock Text="{Binding CalculationResult.SigmaMax2_GW_Base, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²)  &lt;  1.2 Rtc = " /><TextBlock Text="{Binding CalculationResult.Rtc2_GW_Base_12, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#27AE60"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="N0 = " /><TextBlock Text="{Binding CalculationResult.N02_GW_Base, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="σtb = " /><TextBlock Text="{Binding CalculationResult.SigmaTb2_GW_Base, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²)  &lt;  Rtc = " /><TextBlock Text="{Binding CalculationResult.Rtc2_GW_Base, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#27AE60"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="σmin = " /><TextBlock Text="{Binding CalculationResult.SigmaMin2_GW_Base, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T/m²) "/><TextBlock Text="{Binding CalculationResult.SigmaMin2_GW_Base_Text}" FontWeight="Bold" Foreground="{Binding CalculationResult.SigmaMin2_GW_Base_Color}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2. Kiểm tra ổn định Chống lật & Chống trượt -->
                    <StackPanel Margin="0,10,0,15">
                        <TextBlock Text="2. Kiểm tra ổn định chống lật và chống trượt móng (Tổ hợp Chi Phối: GIÓ 90° MAX)" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10" />

                        <!-- Chống lật Kcl -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="10,0,0,8">
                            <StackPanel>
                                <TextBlock Text="a. Kiểm tra ổn định chống lật móng (Kcl):" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="Mgiữ = " /><TextBlock Text="{Binding CalculationResult.M_Giu, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T.m)"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="🔵 Gió 90° (Chi phối): Kcl = " FontWeight="SemiBold" Foreground="#2563EB"/>
                                        <TextBlock Text="{Binding CalculationResult.K_cl, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#2563EB"/>
                                        <TextBlock Text="  ≥  Kcp = 1.50  " />
                                        <TextBlock Visibility="{Binding CalculationResult.IsPass_Kcl, Converter={StaticResource BooleanToVisibilityConverter}}" Text=" (Thỏa mãn)" FontWeight="Bold" Foreground="#27AE60"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="🟡 Gió 45°: Kcl = " Foreground="#D97706"/>
                                        <TextBlock Text="{Binding CalculationResult.K_cl_G45, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#D97706"/>
                                        <TextBlock Text="  ≥  Kcp = 1.50  (Thỏa mãn)" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Chống trượt Ktr -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="10,0,0,8">
                            <StackPanel>
                                <TextBlock Text="b. Kiểm tra ổn định chống trượt móng (Ktr):" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="Fms = N0.tan(φ1) = " /><TextBlock Text="{Binding CalculationResult.F_ms, StringFormat={}{0:F2}}" FontWeight="Bold"/><TextBlock Text=" (T)"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="🔵 Gió 90° (Chi phối): Ktr = " FontWeight="SemiBold" Foreground="#2563EB"/>
                                        <TextBlock Text="{Binding CalculationResult.K_tr, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#2563EB"/>
                                        <TextBlock Text="  ≥  Kcp = 1.30  " />
                                        <TextBlock Visibility="{Binding CalculationResult.IsPass_Ktr, Converter={StaticResource BooleanToVisibilityConverter}}" Text=" (Thỏa mãn)" FontWeight="Bold" Foreground="#27AE60"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="🟡 Gió 45°: Ktr = " Foreground="#D97706"/>
                                        <TextBlock Text="{Binding CalculationResult.K_tr_G45, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#D97706"/>
                                        <TextBlock Text="  ≥  Kcp = 1.30  (Thỏa mãn)" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Kết luận -->
                    <Border Padding="10" Margin="0,10,0,0" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FADBD8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CalculationResult.IsOverallPass}" Value="True">
                                        <Setter Property="Background" Value="#D4EFDF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontWeight="Bold" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Kích thước móng CHƯA thỏa mãn điều kiện áp lực đáy móng!" />
                                    <Setter Property="Foreground" Value="#C0392B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CalculationResult.IsOverallPass}" Value="True">
                                            <Setter Property="Text" Value="Kích thước móng ĐÃ thỏa mãn điều kiện áp lực đáy móng!" />
                                            <Setter Property="Foreground" Value="#27AE60" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>


        <!-- COLUMN 3: Bảng dự tính độ lún -->
        <Border Grid.Column="2"
                Background="White"
                Margin="5"
                Padding="15"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="#2C3E50" BlurRadius="10" Opacity="0.1" ShadowDepth="2" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="3. Bảng dự tính độ lún" FontWeight="Bold" FontSize="16" Foreground="#2C3E50" Margin="0,0,0,10" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Ứng suất gây lún σ0 = " />
                    <TextBlock Text="{Binding CalculationResult.Sigma0, StringFormat={}{0:F4}}" FontWeight="Bold" Foreground="#C0392B" />
                    <TextBlock Text=" (T/m²)" />
                </StackPanel>

                <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,5,0,0">
                    <!-- TAB 1: BẢNG CHI TIẾT TÍNH LÚN -->
                    <TabItem Header="Bảng Tính Lún (Phân Lớp)">
                        <DataGrid ItemsSource="{Binding CalculationResult.SettlementLayers}" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#F8FAFC"
                                  Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding Id}" Width="38" />
                                <DataGridTextColumn Header="2z/b" Binding="{Binding Ratio2ZB, StringFormat={}{0:F2}}" Width="45" />
                                <DataGridTextColumn Header="z (m)" Binding="{Binding Z, StringFormat={}{0:F3}}" Width="52" />
                                <DataGridTextColumn Header="K" Binding="{Binding K, StringFormat={}{0:F3}}" Width="45" />
                                <DataGridTextColumn Header="Ei (T/m²)" Binding="{Binding Ei}" Width="65" />
                                <DataGridTextColumn Header="β" Binding="{Binding Beta}" Width="38" />
                                <DataGridTextColumn Header="σi (T/m²)" Binding="{Binding SigmaZi, StringFormat={}{0:F4}}" Width="68" />
                                <DataGridTextColumn Header="Σγi.hi" Binding="{Binding SumGammaHi, StringFormat={}{0:F4}}" Width="68" />
                                <DataGridTextColumn Header="si (mm)" Binding="{Binding Si, StringFormat={}{0:F4}}" Width="65" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- TAB 2: BIỂU ĐỒ LÚN & ỨNG SUẤT -->
                    <TabItem Header="Biểu Đồ Lún &amp; Ứng Suất">
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                            <Canvas x:Name="SettlementCanvas" SizeChanged="DrawingCanvas_SizeChanged" Background="White"/>
                        </Border>
                    </TabItem>
                </TabControl>

                <StackPanel Grid.Row="3" Margin="0,15,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Chiều sâu ảnh hưởng lún (σi ≤ 0.1Σγi.hi) Hc = " />
                        <TextBlock Text="{Binding CalculationResult.InfluenceDepth, StringFormat={}{0:F2}}" FontWeight="Bold" />
                        <TextBlock Text=" (m)" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Tổng độ lún S = " FontSize="14" FontWeight="Bold" Foreground="#2C3E50" />
                        <TextBlock Text="{Binding CalculationResult.TotalSettlement, StringFormat={}{0:F2}}" FontSize="14" FontWeight="Bold" Foreground="#C0392B" />
                        <TextBlock Text=" (mm)" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" />
                    </StackPanel>

                    <!-- 4. KIỂM TRA ĐỘ NGHIÊNG MÓNG (TAN THETA) -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="4. Kiểm tra độ nghiêng của móng (tgθ)" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" Foreground="#475569" Margin="0,0,0,3">
                                <Run Text="Môdun biến dạng TB Etb = "/>
                                <Run Text="{Binding CalculationResult.Etb, StringFormat={}{0:F1}, Mode=OneWay}" FontWeight="Bold" Foreground="#0F172A"/>
                                <Run Text=" T/m²"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#475569" Margin="0,0,0,3">
                                <Run Text="Mômen TB hàng năm Mytb = "/>
                                <Run Text="{Binding CalculationResult.M_tb_y, StringFormat={}{0:F2}, Mode=OneWay}" FontWeight="Bold" Foreground="#1D4ED8"/>
                                <Run Text=" T.m (ktb = "/>
                                <Run Text="{Binding CalculationResult.K_tb_Factor, StringFormat={}{0:F2}, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,4">
                                <TextBlock Text="Độ nghiêng tgθ = " FontWeight="Bold" Foreground="#1E293B" FontSize="12"/>
                                <TextBlock Text="{Binding CalculationResult.TanTheta, StringFormat={}{0:F5}, Mode=OneWay}" FontWeight="Bold" Foreground="#2563EB" FontSize="12"/>
                                <TextBlock Text="  &lt; [tgθ] = " FontSize="12"/>
                                <TextBlock Text="{Binding CalculationResult.AllowableTanTheta, StringFormat={}{0:F4}, Mode=OneWay}" FontWeight="Bold" Foreground="#1E293B" FontSize="12"/>
                            </StackPanel>
                            <Border CornerRadius="4" Padding="6,4" Margin="0,2,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CalculationResult.IsPass_Tilt, Mode=OneWay}" Value="False">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontWeight="Bold" HorizontalAlignment="Center" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="✓ THỎA MÃN ĐỘ NGHIÊNG CỦA MÓNG"/>
                                            <Setter Property="Foreground" Value="#15803D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CalculationResult.IsPass_Tilt, Mode=OneWay}" Value="False">
                                                    <Setter Property="Text" Value="✕ KHÔNG THỎA MÃN ĐỘ NGHIÊNG CỦA MÓNG!"/>
                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
