<UserControl x:Class="FAE.Foundation.App.Features.RibbedRaft.GeotechCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FAE.Foundation.App.Services.Localization"
             Language="en-US">
    <Grid Background="#F5F6FA"
          Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- COLUMN 1: Settings & Sections -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="5">
                <Border Background="White"
                        Padding="15"
                        CornerRadius="8"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Thông số nền đất"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Chọn hố khoan:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableBoreholes}"
                                      SelectedItem="{Binding CurrentBorehole}"
                                      DisplayMemberPath="BoreholeName"
                                      Padding="5" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Độ sâu móng (H):"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Model.Depth, UpdateSourceTrigger=PropertyChanged, Delay=800}"
                                     VerticalAlignment="Center"
                                     Padding="4" />
                            <TextBlock Grid.Column="2"
                                       Text="m"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0" />
                        </Grid>

                        <!-- Tùy chọn đệm cát -->
                        <CheckBox Content="Sử dụng đệm cát"
                                  IsChecked="{Binding Model.HasSandCushion, UpdateSourceTrigger=PropertyChanged}"
                                  FontWeight="SemiBold"
                                  Margin="0,10,0,5" />
                        <Grid IsEnabled="{Binding Model.HasSandCushion}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Bề dày đệm cát:"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Model.SandThickness, UpdateSourceTrigger=PropertyChanged, Delay=800}"
                                     VerticalAlignment="Center"
                                     Padding="4" />
                            <TextBlock Grid.Column="2"
                                       Text="m"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0" />
                        </Grid>

                        <!-- Tùy chọn đất đắp -->
                        <CheckBox Content="Đắp đất chống nhổ"
                                  IsChecked="{Binding Model.HasMound, UpdateSourceTrigger=PropertyChanged}"
                                  FontWeight="SemiBold"
                                  Margin="0,10,0,5" />
                        <Grid IsEnabled="{Binding Model.HasMound}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Chiều cao đất đắp:"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Model.MoundHeight, UpdateSourceTrigger=PropertyChanged, Delay=800}"
                                     VerticalAlignment="Center"
                                     Padding="4" />
                            <TextBlock Grid.Column="2"
                                       Text="m"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0" />
                        </Grid>
                        <!-- Tùy chọn Mực nước ngầm -->
                        <CheckBox Content="Có mực nước ngầm (MNN)"
                                  IsChecked="{Binding Model.HasGroundwater, UpdateSourceTrigger=PropertyChanged}"
                                  FontWeight="SemiBold"
                                  Margin="0,10,0,5" />
                        <Grid IsEnabled="{Binding Model.HasGroundwater}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Độ sâu MNN:"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Model.GroundwaterElev, UpdateSourceTrigger=PropertyChanged, Delay=800}"
                                     VerticalAlignment="Center"
                                     Padding="4" />
                            <TextBlock Grid.Column="2"
                                       Text="m"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0" />
                        </Grid>

                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="8"
                        Padding="5"
                        MinHeight="300"
                        Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="{Binding Path=Strings[SectionX], Source={x:Static loc:LocalizationService.Instance}}"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Margin="5"
                                   Panel.ZIndex="1" />
                        <Canvas x:Name="SectionXCanvas"
                                ClipToBounds="True"
                                Background="#F8FAFC"
                                SizeChanged="DrawingCanvas_SizeChanged" />
                    </Grid>
                </Border>

                <Border Background="White"
                        CornerRadius="8"
                        Padding="5"
                        MinHeight="300">
                    <Grid>
                        <TextBlock Text="{Binding Path=Strings[SectionY], Source={x:Static loc:LocalizationService.Instance}}"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Margin="5"
                                   Panel.ZIndex="1" />
                        <Canvas x:Name="SectionYCanvas"
                                ClipToBounds="True"
                                Background="#F8FAFC"
                                SizeChanged="DrawingCanvas_SizeChanged" />
                    </Grid>
                </Border>

                <!-- Chú thích chung các lớp địa chất -->
                <Border Background="White"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Chú thích các lớp địa chất:"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding CurrentBorehole.Layers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,5,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LayerId}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LayerId}"
                                                                 Value="">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Grid Width="20"
                                              Height="20"
                                              Margin="0,0,10,0">
                                            <Ellipse Stroke="SaddleBrown"
                                                     StrokeThickness="1"
                                                     Fill="White" />
                                            <TextBlock Text="{Binding LayerId}"
                                                       Foreground="SaddleBrown"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10" />
                                        </Grid>
                                        <TextBlock Text="{Binding LayerName}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#34495E" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- COLUMN 2: Kết quả tính ứng suất -->
        <Border Grid.Column="1"
                Background="White"
                Margin="5"
                Padding="15"
                CornerRadius="8">
            <TextBlock Text="Kết quả tính ứng suất (Sẽ cập nhật)"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       FontStyle="Italic" />
        </Border>

        <!-- COLUMN 3: Bảng dự tính độ lún -->
        <Border Grid.Column="2"
                Background="White"
                Margin="5"
                Padding="15"
                CornerRadius="8">
            <TextBlock Text="Bảng dự tính độ lún (Sẽ cập nhật)"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       FontStyle="Italic" />
        </Border>
    </Grid>
</UserControl>
