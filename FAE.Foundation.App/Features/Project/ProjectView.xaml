<UserControl x:Class="FAE.Foundation.App.Features.Project.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ribbedRaft="clr-namespace:FAE.Foundation.App.Features.RibbedRaft"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="#F5F6FA">
    <Grid>
        <Grid.Resources>
            <Style x:Key="RightAligned" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,0,5,0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- TabControl -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="THIẾT KẾ MÓNG ĐƯỜNG DÂY TẢI ĐIỆN" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Lưu (Save)" Width="100" Height="30" Margin="0,0,10,0" Background="#E67E22" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SaveDataButton_Click"/>
                    <Button Content="Mở (Load)" Width="100" Height="30" Margin="0,0,20,0" Background="#9B59B6" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="LoadDataButton_Click"/>
                    
                    <TextBlock Text="Địa chất (Hố khoan):" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="20,0,10,0"/>
                    <ComboBox ItemsSource="{Binding Boreholes}" 
                              SelectedItem="{Binding SelectedTower.Borehole, Mode=TwoWay}" 
                              DisplayMemberPath="BoreholeName" 
                              Width="100" 
                              Height="30"
                              FontSize="14"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Margin="10" Background="White" BorderBrush="#BDC3C7" BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="15,10"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#7F8C8D"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#2980B9"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: NHẬP LIỆU (DATA INPUT) -->
            <TabItem Header="1. Nội lực (Forces)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <GroupBox Grid.Row="0" Header="Nhập Dữ Liệu Nội Lực (Từ Excel / Clipboard)" Margin="0,0,0,10" BorderBrush="#BDC3C7" BorderThickness="1">
                        <StackPanel Margin="10">
                            <!-- Hàng 1: Chọn File -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Đường dẫn:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding ExcelFilePath}" IsReadOnly="True" VerticalAlignment="Center" Padding="5"/>
                                <Button Grid.Column="2" Content="..." Width="40" Padding="5" Margin="5,0,0,0" Click="BrowseExcel_Click" Background="#ECF0F1" BorderBrush="#BDC3C7" BorderThickness="1"/>
                            </Grid>

                            <!-- Hàng 2: Chọn Sheet & Nhập -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Chọn Sheet:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ExcelSheets}" SelectedItem="{Binding SelectedExcelSheet}" VerticalAlignment="Center" Padding="5"/>
                                <Button Grid.Column="2" Content="Nhập Excel" Width="120" Padding="10,5" Click="ImportExcel_Click" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="15,0,10,0"/>
                                <Button Grid.Column="3" Content="Dán từ Clipboard" Width="130" Padding="10,5" Click="PasteButton_Click" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                    
                    <!-- Pseudo DataGrid cho Nội lực -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Search Bar & Count -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Tìm kiếm Trụ:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#34495E" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Width="200" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="5" VerticalAlignment="Center" BorderBrush="#BDC3C7" BorderThickness="1"/>
                            
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Tổng số Trụ:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,8,0"/>
                                <Border Background="#E74C3C" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="{Binding Towers.Count}" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Bảng Nội Lực (Sử dụng Style từ thư viện) -->
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <ListBox Style="{StaticResource ForceListBoxStyle}" 
                                     ItemsSource="{Binding TowersView}" 
                                     SelectedItem="{Binding SelectedTower}" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: ĐỊA CHẤT -->
            <TabItem Header="2. Thư viện Địa chất (Geology)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Import Area -->
                    <GroupBox Grid.Row="0" Header="Nhập Dữ Liệu Địa Chất (Từ Excel / Clipboard)" Margin="0,0,0,10" BorderBrush="#BDC3C7" BorderThickness="1">
                        <StackPanel Margin="10">
                            <!-- Hàng 1: Chọn File -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Đường dẫn:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding GeologyExcelFilePath}" IsReadOnly="True" VerticalAlignment="Center" Padding="5"/>
                                <Button Grid.Column="2" Content="..." Width="40" Padding="5" Margin="5,0,0,0" Click="BrowseGeologyExcel_Click" Background="#ECF0F1" BorderBrush="#BDC3C7" BorderThickness="1"/>
                            </Grid>

                            <!-- Hàng 2: Chọn Sheet & Nhập -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Chọn Sheet:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding GeologyExcelSheets}" SelectedItem="{Binding SelectedGeologyExcelSheet}" VerticalAlignment="Center" Padding="5"/>
                                <Button Grid.Column="2" Content="Nhập Excel" Width="120" Padding="10,5" Click="ImportGeologyExcel_Click" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="15,0,10,0"/>
                                <Button Grid.Column="3" Content="Dán từ Clipboard" Width="130" Padding="10,5" Click="PasteGeologyButton_Click" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Borehole List -->
                        <Border Grid.Column="0" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Danh sách Hố khoan" Background="#ECF0F1" Margin="10,5" FontWeight="Bold"/>
                                <ListBox Grid.Row="1" ItemsSource="{Binding Boreholes}" SelectedItem="{Binding SelectedBorehole}" DisplayMemberPath="BoreholeName" BorderThickness="0" Background="White"/>
                                <Button Grid.Row="2" Content="Thêm hố khoan rỗng" Click="AddEmptyBorehole_Click" Margin="5" Padding="5"/>
                            </Grid>
                        </Border>
                        
                        <!-- Soil Layers Grid -->
                        <Border Grid.Column="2" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Background="#ECF0F1" Margin="10,5">
                                    <TextBlock Text="Các lớp đất của:" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedBorehole.BoreholeName}" FontWeight="Bold" Foreground="#2980B9" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedBorehole.Layers}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" AlternatingRowBackground="#F8F9F9" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Lớp" Binding="{Binding LayerId}" Width="60"/>
                                        <DataGridTextColumn Header="Tên Lớp" Binding="{Binding LayerName}" Width="150"/>
                                        <DataGridTextColumn Header="Chiều dày (m)" Binding="{Binding Thickness}" Width="90"/>
                                        <DataGridTextColumn Header="γw (T/m³)" Binding="{Binding GammaW}" Width="80"/>
                                        <DataGridTextColumn Header="Δ" Binding="{Binding Delta}" Width="60"/>
                                        <DataGridTextColumn Header="e0" Binding="{Binding E0}" Width="60"/>
                                        <DataGridTextColumn Header="φ (độ)" Binding="{Binding Phi}" Width="70"/>
                                        <DataGridTextColumn Header="C (T/m²)" Binding="{Binding C}" Width="80"/>
                                        <DataGridTextColumn Header="E (T/m²)" Binding="{Binding E}" Width="80"/>
                                        <DataGridTextColumn Header="γđn (T/m³)" Binding="{Binding GammaDn}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: HÌNH HỌC (GEOMETRY & 3D) -->
            <TabItem Header="3. Kích thước Hình học">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Chọn Trụ Thiết Kế -->
                    <Border Grid.Row="0" Background="#ECF0F1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Chọn Trụ thiết kế:" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding Towers}" 
                                      SelectedItem="{Binding SelectedTower}" 
                                      DisplayMemberPath="TowerName" 
                                      Width="200" 
                                      Padding="5"
                                      VerticalAlignment="Center"/>
                                      
                            <TextBlock Text="Nhịp tự động (Base Dimension):" VerticalAlignment="Center" Margin="20,0,10,0" Foreground="#7F8C8D"/>
                            <TextBlock Text="{Binding SelectedTower.BaseDimension, StringFormat={}{0:N0} mm}" FontWeight="Bold" Foreground="#E67E22" VerticalAlignment="Center"/>
                            
                            <TextBlock Text="Chọn Hố khoan:" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center" Margin="30,0,10,0"/>
                            <ComboBox ItemsSource="{Binding Boreholes}" 
                                      SelectedItem="{Binding DetailViewModel.CurrentBorehole, Mode=TwoWay}" 
                                      DisplayMemberPath="BoreholeName" 
                                      Width="120" 
                                      Padding="5"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <ribbedRaft:RibbedRaftView Grid.Row="1" DataContext="{Binding DetailViewModel}" />
                </Grid>
            </TabItem>

            <!-- TAB 4: KIỂM TRA NỀN (GEOTECHNICAL) -->
            <TabItem Header="4. Kiểm tra Nền (Geotech)">
                <ribbedRaft:GeotechCheckView DataContext="{Binding DetailViewModel}" />
            </TabItem>

            <!-- TAB 5: KIỂM TRA KẾT CẤU (STRUCTURAL) -->
            <TabItem Header="5. Kiểm tra Kết cấu (Structural)">
                <Grid Margin="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Đang thi công mô-đun Kiểm tra Kết cấu TCVN 5574:2018..." FontSize="16" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sẽ hiển thị Biểu đồ Mô men và diện tích cốt thép As tại đây." FontSize="14" Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
